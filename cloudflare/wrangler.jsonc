// Bot de «server up» de Isla Brava RP (Cloudflare Workers, gratis)
// Lo que se puede cambiar está en "vars". Las claves van como Secrets (ver README):
//   DISCORD_TOKEN        token del bot
//   DISCORD_PUBLIC_KEY   clave pública de la aplicación de Discord
//   SERVERUP_KEY         clave que comparten el bot y el servidor de FiveM (invéntala, larga)
{
  "name": "islabrava-serverup",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "vars": {
    // ID de la aplicación de Discord (Developer Portal → General Information → Application ID)
    "DISCORD_APP_ID": "1562153483032072263",
    // ID de tu servidor de Discord: los comandos salen al momento (sin él tardan un poco más)
    "GUILD_ID": "",
    // Canal donde se publica el server up (clic derecho en el canal → Copiar ID)
    "CHANNEL_ID": "",
    // A quién se avisa: "everyone", "here", el ID de un rol, o "" para no mencionar a nadie
    "PING": "everyone",
    // Roles que pueden usar /serverup además de los administradores (IDs separados por comas)
    "STAFF_ROLE_IDS": "",

    // Cómo se ve el aviso
    "SERVER_NAME": "Isla Brava RP",
    "TITLE": "SERVER UP",
    "MESSAGE": "¡La isla está abierta! Ya pueden entrar a rolear.",
    "GIF_URL": "https://r2.fivemanage.com/G9m8tDHp4yVCd283cW1YL/server_up.gif",
    "COLOR": "#2ecc71",
    // Enlace para entrar (cfx.re/join/xxxxxx). Sale el botón «Conectar» y el comando connect
    "CONNECT_URL": "",
    // Opcional: dirección del servidor para enseñar los jugadores, p. ej. "http://123.45.67.89:30120"
    "FIVEM_ENDPOINT": "",

    // Minutos en los que no se repite el aviso automático (si el servidor reinicia varias veces seguidas)
    "COOLDOWN_MIN": "10"
  },
  "observability": { "enabled": true }
}
