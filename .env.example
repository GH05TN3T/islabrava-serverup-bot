# Copia este archivo como .env (o pon estas variables en el panel de tu hosting).
# El .env NO se sube a GitHub.

# --- obligatorio
DISCORD_TOKEN=pega-aqui-el-token-del-bot
CHANNEL_ID=
# ID de tu servidor de Discord (el comando /serverup sale al momento)
GUILD_ID=

# --- a quién se avisa: everyone, here, el ID de un rol, o vacío para no mencionar
PING=everyone
# roles que pueden usar /serverup además de los admins (IDs separados por comas)
STAFF_ROLE_IDS=

# --- cómo se ve el aviso
SERVER_NAME=Isla Brava RP
TITLE=SERVER UP
MESSAGE=¡La isla está abierta! Ya pueden entrar a rolear.
GIF_URL=https://r2.fivemanage.com/G9m8tDHp4yVCd283cW1YL/server_up.gif
COLOR=#2ecc71
CONNECT_URL=https://cfx.re/join/xxxxxx

# --- server up automático: dirección de tu servidor de FiveM (IP:puerto)
# El bot la mira cada CHECK_SECONDS y publica cuando pasa de apagado a encendido.
FIVEM_ENDPOINT=http://123.45.67.89:30120
CHECK_SECONDS=30
COOLDOWN_MIN=10

# --- opcional: para que el recurso islabrava_serverup avise al arrancar
# (solo si tu hosting deja abrir un puerto)
PORT=
SERVERUP_KEY=
